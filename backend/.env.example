# Copy to .env and fill in. Leave the Supabase values empty to run without saving.
# Supabase dashboard -> Project Settings -> API Keys.
# Either a secret key (sb_secret_...) or the legacy service_role key (eyJ...) works.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, e.g. for Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://timetable-generator.*\.vercel\.app
